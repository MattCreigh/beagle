# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
# Built wheels under dist/ ARE tracked (release artefacts); sdists are not.
dist/*.tar.gz
.venv/
venv/

# LaTeX build artifacts (docs/spec)
*.aux
*.lof
*.lot
*.toc
*.out
*.synctex.gz
docs/spec/*.log
docs/spec/*.pdf

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.benchmarks/
.coverage
htmlcov/

# Property-based testing artifacts
.hypothesis/

# Local QA-toolchain state (machine-specific)
.beagle_ingest_cache.json

# Runtime state — never in the repo
.beagle/
.goose/
*.ring

# OS
.DS_Store

# Local secrets / env
.env
*.key
secrets.yaml
