// markdownlint-cli2 project profile — Beagle.
// Extends the shared QA profile. The auto-generated XML-in-MD pointer files
// (CLAUDE.md, src/beagle/CLAUDE.md) are emitted by `beagle render-prompts`
// and are not hand-edited Markdown, so they are excluded from linting.
{
  "config": {
    "default": true,
    "MD013": { "line_length": 100, "tables": false, "code_blocks": false, "headings": false },
    "MD024": { "siblings_only": true },
    "MD041": false,
    "MD033": {
      "allowed_elements": [
        "br", "details", "summary", "img", "a", "kbd", "sub", "sup",
        "div", "h1", "h2", "h3", "p", "strong", "em", "center", "picture", "source",
        "invariant", "config-change", "verification-checklist",
        "file", "change", "reason", "pending_disposition",
        "awaiting_user_approval", "deliberation_matrix", "final_answer",
        "beagle_pointer", "canonical_sources", "codebase_context", "notice",
        "source", "title", "use"
      ]
    },
    "MD029": { "style": "one_or_ordered" },
    "MD036": true,
    "MD034": true,
    "MD040": true,
    "MD060": false,
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    "MD049": { "style": "asterisk" },
    "MD050": { "style": "asterisk" }
  },
  "ignores": [
    // Auto-generated XML-in-MD pointer files (emitted by `beagle render-prompts`).
    "CLAUDE.md",
    "src/beagle/CLAUDE.md",
    // Auto-generated by `beagle render-docs`; do not hand-edit. Both spellings
    // are listed: the file lives at src/beagle/docs/ in this repo, while the
    // wheel-installed copy renders to beagle/docs/. The previous entry named
    // only "docs/DOCTRINE.md", which matched NEITHER location, so the exclusion
    // intended here never applied.
    "docs/DOCTRINE.md",
    "src/beagle/docs/DOCTRINE.md"
  ]
}
