#!/bin/bash
# gup — Git sync for the beagle-dockeriser project.
#
# Usage: gup [commit-message]
#
# Stages all changes, commits, pulls --rebase, and pushes.
# Defaults to an auto-generated timestamp message if none given.

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

MSG="${1:-Auto-sync $(date +%Y-%m-%d_%H-%M-%S)}"
BRANCH=$(git branch --show-current)

echo -e "${BLUE}════════════════════════════════════════${NC}"
echo -e "${BLUE}  gup: beagle-dockeriser [${BRANCH}]${NC}"
echo -e "${BLUE}════════════════════════════════════════${NC}"

if git diff --quiet && git diff --cached --quiet && [ -z "$(git ls-files --others --exclude-standard)" ]; then
    echo -e "${GREEN}No changes to commit${NC}"
    git pull --rebase origin "$BRANCH" 2>/dev/null && echo -e "${GREEN}Pulled latest${NC}"
    exit 0
fi

git add -A
echo -e "${YELLOW}Committing...${NC}"
git commit -m "$MSG"

echo -e "${YELLOW}Pulling (rebase)...${NC}"
git pull --rebase origin "$BRANCH"

echo -e "${YELLOW}Pushing...${NC}"
git push origin "$BRANCH"

echo -e "${GREEN}✓ Synced${NC}"
