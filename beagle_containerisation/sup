#!/usr/bin/env python3
"""
sup — Context hydration tool for the beagle-dockeriser project.

Generates a comprehensive codebase dump for LLM consumption.

Usage:
    sup                  # Dump current directory
    sup --md             # Output as Markdown
    sup --quick          # Quick mode (skip large files)
    sup --system         # Include system context
"""
import os
import sys
import tomllib
import argparse
import subprocess
from pathlib import Path
from datetime import datetime
from typing import Optional

# --- Configuration ---
DUMP_ROOT = Path("/opt/codebase_dumps")
MAX_FILE_SIZE_DEFAULT = 100 * 1024  # 100KB
MAX_FILE_SIZE_QUICK = 20 * 1024     # 20KB
MAX_DEPTH_QUICK = 3


class C:
    BLUE = '\033[34m'
    GREEN = '\033[32m'
    YELLOW = '\033[33m'
    RED = '\033[31m'
    CYAN = '\033[36m'
    BOLD = '\033[1m'
    END = '\033[0m'


def log(msg: str, color: str = C.BLUE):
    print(f"[{color}sup{C.END}] {msg}")


def warn(msg: str):
    print(f"[{C.YELLOW}WARN{C.END}] {msg}")


def err(msg: str):
    print(f"[{C.RED}ERROR{C.END}] {msg}")


def load_config() -> dict:
    config_locations = [
        Path.cwd() / ".sup.toml",
    ]
    for conf_path in config_locations:
        if conf_path.exists():
            with open(conf_path, "rb") as f:
                return tomllib.load(f)
    return {
        'export': {'ssh_alias': 'localhost', 'local_destination': '.'},
        'filter': {
            'excludes': [
                ".git", "__pycache__", ".venv", "venv", "build", "dist",
                "node_modules", "*.egg-info", ".pytest_cache",
                "*.so", "*.o", ".mypy_cache", ".ruff_cache",
                ".coverage", "htmlcov", "*.log", "*.lock", ".DS_Store",
                ".env", "*.pyc"
            ],
            'extensions': [
                ".py", ".txt", ".md", ".toml", ".yaml", ".yml",
                ".json", ".sh", "Dockerfile", "Makefile"
            ]
        }
    }


def is_excluded(path: Path, excludes: list) -> bool:
    parts = path.parts
    for ex in excludes:
        if ex in parts or path.match(ex):
            return True
    return False


def has_extension(path: Path, extensions: list) -> bool:
    return path.suffix in extensions or path.name in extensions


def run_cmd(cmd: str, timeout: int = 30) -> str:
    try:
        result = subprocess.run(
            cmd, shell=True, capture_output=True, text=True, timeout=timeout
        )
        return result.stdout.strip() if result.returncode == 0 else f"[Error: {result.stderr.strip()}]"
    except subprocess.TimeoutExpired:
        return f"[Timeout after {timeout}s]"
    except Exception as e:
        return f"[Error: {e}]"


def get_system_context() -> str:
    sections = []
    sections.append("## System Identity\n")
    sections.append(f"- Hostname: `{run_cmd('hostname')}`")
    sections.append(f"- User: `{os.getenv('USER', 'unknown')}`")
    os_name = run_cmd("grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '\"'")
    sections.append(f"- OS: `{os_name}`")
    sections.append("")
    sections.append("## Hardware\n")
    cpu = run_cmd("grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | xargs")
    mem = run_cmd("free -h | grep Mem | awk '{print $2}'")
    sections.append(f"- CPU: `{cpu}`")
    sections.append(f"- Memory: `{mem}` total")
    sections.append(f"- Cores: `{run_cmd('nproc')}`")
    sections.append("")
    sections.append("## Storage\n```")
    sections.append(run_cmd("df -h | grep -E '^/dev|Filesystem'"))
    sections.append("```\n")
    return "\n".join(sections)


def write_tree(f, root: Path, excludes: list, format_md: bool):
    exclude_pattern = "|".join(excludes + ["__pycache__", ".git", "*.pyc"])
    if format_md:
        f.write("## Directory Structure\n\n```\n")
    else:
        f.write("=== DIRECTORY STRUCTURE ===\n")
    f.flush()
    tree_output = run_cmd(
        f"tree -a -I '{exclude_pattern}' '{root}' 2>/dev/null || find '{root}' -type f | head -80"
    )
    f.write(tree_output)
    if format_md:
        f.write("\n```\n\n---\n\n")
    else:
        f.write(f"\n{'='*60}\n\n")


def write_file_content(f, path: Path, rel_path: Path, format_md: bool):
    try:
        content = path.read_text(encoding="utf-8", errors="replace")
        ext_to_lang = {
            '.py': 'python', '.js': 'javascript', '.ts': 'typescript',
            '.sh': 'bash', '.yml': 'yaml', '.yaml': 'yaml',
            '.json': 'json', '.toml': 'toml', '.md': 'markdown',
            '.rs': 'rust',
        }
        lang = ext_to_lang.get(path.suffix, '')
        if format_md:
            f.write(f"### `{rel_path}`\n\n")
            f.write(f"```{lang}\n{content}")
            if not content.endswith('\n'):
                f.write('\n')
            f.write("```\n\n")
        else:
            f.write(f"{'─'*60}\nFILE: {rel_path}\n{'─'*60}\n")
            f.write(content)
            f.write("\n\n")
        return True
    except Exception as e:
        warn(f"Failed to read {path}: {e}")
        return False


def run_dump(target_dir: str = ".", args=None):
    cfg = load_config()
    root = Path(target_dir).resolve()
    timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    format_md = args.md if args else False
    include_system = args.system if args else False
    quick_mode = args.quick if args else False
    max_file_size = MAX_FILE_SIZE_QUICK if quick_mode else MAX_FILE_SIZE_DEFAULT
    excludes = cfg['filter']['excludes']
    extensions = cfg['filter']['extensions']

    DUMP_ROOT.mkdir(parents=True, exist_ok=True)

    mode_suffix = "_quick" if quick_mode else ""
    system_suffix = "_sys" if include_system else ""
    final_filename = f"{root.name}_dump{mode_suffix}{system_suffix}_{timestamp}.{'md' if format_md else 'txt'}"
    out_path = DUMP_ROOT / final_filename

    log(f"Scanning: {C.CYAN}{root}{C.END}")
    log(f"Output:   {C.CYAN}{out_path}{C.END}")

    files_processed = 0
    files_skipped = 0

    with open(out_path, "w", encoding="utf-8") as f:
        if format_md:
            f.write(f"# Codebase Dump: {root.name}\n\n> Generated by sup | {timestamp}\n\n---\n\n")
        else:
            f.write(f"{'='*60}\nCODEBASE DUMP: {root.name}\nRoot: {root}\nTimestamp: {timestamp}\n{'='*60}\n\n")

        if include_system:
            f.write(get_system_context())
            f.write("\n---\n\n" if format_md else f"\n{'='*60}\n\n")

        write_tree(f, root, excludes, format_md)

        for path in sorted(root.rglob("*")):
            if path.is_dir():
                continue
            if quick_mode:
                try:
                    rel = path.relative_to(root)
                    if len(rel.parts) > MAX_DEPTH_QUICK:
                        continue
                except ValueError:
                    continue
            if is_excluded(path, excludes):
                continue
            if not has_extension(path, extensions):
                continue
            try:
                file_size = path.stat().st_size
            except OSError:
                continue
            if file_size > max_file_size:
                files_skipped += 1
                continue
            rel_path = path.relative_to(root)
            if write_file_content(f, path, rel_path, format_md):
                files_processed += 1

    out_size_kb = out_path.stat().st_size / 1024
    log(f"{C.GREEN}Complete!{C.END} {files_processed} files, {out_size_kb:.1f} KB output")


def main():
    parser = argparse.ArgumentParser(description="sup — Context hydration for beagle-dockeriser")
    parser.add_argument("path", nargs="?", default=".", help="Target directory")
    parser.add_argument("--system", "-s", action="store_true", help="Include system context")
    parser.add_argument("--quick", "-q", action="store_true", help="Quick mode")
    parser.add_argument("--md", "-m", action="store_true", help="Output as Markdown")
    args = parser.parse_args()
    run_dump(args.path, args)


if __name__ == "__main__":
    main()
